cabal-version:   3.4
name:            cardano-ledger-rdf
version:         0.2.3.0
synopsis:        Cardano transaction RDF graph tooling
description:
  Library and executables for emitting Cardano Conway transactions as RDF,
  fetching transaction CBOR closure lattices, and projecting generated graphs
  through packaged views. Generic transaction inspection, signing, validation,
  diffing, and load-generation remain downstream cardano-tx-tools concerns.

license:         Apache-2.0
license-file:    LICENSE
author:          Paolo Veronelli
maintainer:      paolo.veronelli@gmail.com
homepage:        https://lambdasistemi.github.io/cardano-ledger-rdf/
bug-reports:     https://github.com/lambdasistemi/cardano-ledger-rdf/issues
category:        Cardano
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

flag werror
  description: Enable -Werror (compile-time enforcement of warnings).
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wunused-imports -Wmissing-export-lists -Wname-shadowing
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

  default-extensions:
    DataKinds
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    GADTs
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    PatternSynonyms
    ScopedTypeVariables
    StrictData
    TypeApplications
    TypeOperators
    ViewPatterns

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  exposed-modules:
    Cardano.Tx.Balance
    Cardano.Tx.Blueprint
    Cardano.Tx.Build
    Cardano.Tx.Decode
    Cardano.Tx.Evaluate
    Cardano.Tx.Graph.Emit
    Cardano.Tx.Graph.Emit.Blueprint
    Cardano.Tx.Graph.Emit.Project
    Cardano.Tx.Graph.Resolve
    Cardano.Tx.Graph.Resolve.Web2
    Cardano.Tx.Graph.Rules.Load
    Cardano.Tx.Ledger
    Cardano.Tx.View

  other-modules:
    Cardano.Tx.Credentials
    Cardano.Tx.Deposits
    Cardano.Tx.Graph.Emit.Lookup
    Cardano.Tx.Graph.Emit.Monad
    Cardano.Tx.Graph.Emit.Serialize.JsonLd
    Cardano.Tx.Graph.Emit.Serialize.Turtle
    Cardano.Tx.Graph.Emit.Triple
    Cardano.Tx.Graph.Emit.Vocab
    Cardano.Tx.Graph.Emit.VocabExport
    Cardano.Tx.Graph.Emit.Witness
    Cardano.Tx.Graph.Rules.Load.Bech32
    Cardano.Tx.Graph.Rules.Load.Emit.Overlay
    Cardano.Tx.Graph.Rules.Load.Naming
    Cardano.Tx.Graph.Rules.Load.Parse.Turtle
    Cardano.Tx.Graph.Rules.Load.Parse.Yaml
    Cardano.Tx.Graph.Rules.Load.Resolve.Imports
    Cardano.Tx.Graph.Rules.Load.Types
    Cardano.Tx.Inputs
    Cardano.Tx.Scripts
    Cardano.Tx.View.AssetFlow
    Cardano.Tx.View.CliTree
    Cardano.Tx.View.EntityOccurrences
    Cardano.Tx.View.JsonLd
    Cardano.Tx.View.Turtle
    Cardano.Tx.Witnesses

  build-depends:
    , aeson                      >=2.2  && <2.3
    , aeson-pretty               >=0.8  && <0.9
    , base                       <5
    , base16-bytestring          >=1.0  && <1.1
    , bech32                     >=1.1  && <1.2
    , bytestring                 >=0.12 && <0.13
    , cardano-binary             >=1.8  && <3
    , cardano-crypto             >=1.3  && <3
    , cardano-crypto-class       >=2.3  && <4
    , cardano-data               >=1.3  && <3
    , cardano-ledger-allegra     >=1.9  && <3
    , cardano-ledger-alonzo      >=1.15 && <3
    , cardano-ledger-api         >=1.13 && <3
    , cardano-ledger-binary      >=1.8  && <3
    , cardano-ledger-conway      >=1.21 && <3
    , cardano-ledger-core        >=1.19 && <3
    , cardano-ledger-mary        >=1.10 && <3
    , cardano-ledger-shelley     >=1.18 && <3
    , cardano-slotting           >=0.2  && <0.4
    , cardano-strict-containers  >=0.1  && <0.3
    , containers                 >=0.7  && <0.8
    , crypton                    >=1.0  && <1.1
    , data-default               >=0.8  && <0.9
    , directory                  >=1.3  && <1.4
    , exceptions                 >=0.10 && <0.11
    , filepath                   >=1.5  && <1.6
    , http-client                >=0.7  && <0.8
    , http-client-tls            >=0.3  && <0.4
    , http-types                 >=0.12 && <0.13
    , libyaml                    >=0.1  && <0.2
    , memory                     >=0.18 && <0.19
    , microlens                  >=0.4  && <0.5
    , operational                >=0.2  && <0.3
    , optparse-applicative       >=0.19 && <0.20
    , plutus-core                >=1.60 && <3
    , plutus-tx                  >=1.60 && <3
    , scientific                 >=0.3  && <0.4
    , serialise                  >=0.2  && <0.3
    , text                       >=2.1  && <2.2
    , time                       >=1.12 && <1.13
    , transformers               >=0.6  && <0.7
    , tree-view                  >=0.5  && <0.6
    , yaml                       >=0.11 && <0.12

executable tx-graph
  import:           warnings
  hs-source-dirs:   app/tx-graph
  main-is:          Main.hs
  default-language: GHC2021
  autogen-modules:  Paths_cardano_ledger_rdf
  other-modules:    Paths_cardano_ledger_rdf
  build-depends:
    , base
    , base16-bytestring      >=1.0  && <1.1
    , bytestring             >=0.12 && <0.13
    , cardano-crypto-class   >=2.3  && <4
    , cardano-ledger-api     >=1.13 && <3
    , cardano-ledger-conway  >=1.21 && <3
    , cardano-ledger-core    >=1.19 && <3
    , cardano-ledger-rdf
    , containers             >=0.7  && <0.8
    , directory              >=1.3  && <1.4
    , filepath               >=1.5  && <1.6
    , microlens              >=0.4  && <0.5
    , optparse-applicative   >=0.19 && <0.20
    , text                   >=2.1  && <2.2

