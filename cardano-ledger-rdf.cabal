  build-depends:
    , base
    , base16-bytestring     >=1.0  && <1.1
    , bytestring            >=0.12 && <0.13
    , cardano-crypto-class  >=2.3  && <4
    , cardano-ledger-api    >=1.13 && <3
    , cardano-ledger-core   >=1.19 && <3
    , cardano-ledger-rdf
    , containers            >=0.7  && <0.8
    , directory             >=1.3  && <1.4
    , filepath              >=1.5  && <1.6
    , http-client           >=0.7  && <0.8
    , http-client-tls       >=0.3  && <0.4
    , microlens             >=0.4  && <0.5
    , optparse-applicative  >=0.19 && <0.20
    , text                  >=2.1  && <2.2

executable tx-view
  import:           warnings
  hs-source-dirs:   app/tx-view
  main-is:          Main.hs
  default-language: GHC2021
  autogen-modules:  Paths_cardano_ledger_rdf
