  -- Cabal places tx-view on PATH for `cabal test`, so
  -- Cardano.Tx.View.CliTreeGoldenSpec can spawn it as a subprocess
  -- without a `cabal list-bin` env-var dance in the dev shell. The
  -- nix flake check path wires the same store path through
  -- TX_VIEW_EXE (see flake.nix's unit-check override).
  build-tool-depends: cardano-ledger-rdf:tx-view

source-repository head
