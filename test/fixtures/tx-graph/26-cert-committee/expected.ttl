  cardano:bytesHex "29288f282d05bb602f2a8c3b2896d6e119b12cdad68b23003a5915233b1f8c92" .

#
# Certificate 1
#

_:cert1 a cardano:Certificate ;
  a cardano:AuthCommitteeHotKey ;
  cardano:hasCommitteeColdCredential _:cred_committeecoldkey_99999999999999999999999999999999999999999999999999999999 ;
  cardano:hasCommitteeHotCredential _:cred_committeehotkey_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa .

_:cred_committeecoldkey_99999999999999999999999999999999999999999999999999999999 a cardano:Identifier ;
