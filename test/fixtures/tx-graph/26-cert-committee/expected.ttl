#
# Transaction body.
#

_:tx a cardano:Transaction ;
  cardano:hasTxId _:hash_txid_29288f282d05bb602f2a8c3b2896d6e119b12cdad68b23003a5915233b1f8c92 ;
  cardano:isValid "true"^^xsd:boolean ;
  cardano:hasCertificate _:cert1 ;
  cardano:hasCertificate _:cert2 ;
