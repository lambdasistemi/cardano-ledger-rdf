_:cred_committeehotkey_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa a cardano:Identifier ;
  cardano:leafType "CommitteeHotKey" ;
  cardano:bytesHex "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

#
# Certificate 2
#

_:cert2 a cardano:Certificate ;
  a cardano:ResignCommitteeColdKey ;
  cardano:hasCommitteeColdCredential _:cred_committeecoldkey_99999999999999999999999999999999999999999999999999999999 ;
  cardano:hasAnchor _:cert2Anchor .

_:cred_committeecoldkey_99999999999999999999999999999999999999999999999999999999 a cardano:Identifier ;
  cardano:leafType "CommitteeColdKey" ;
