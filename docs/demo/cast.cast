[0.008007, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.008265, "o", "\u001b[1;36m# cardano-ledger-rdf — Conway tx in, RDF out, SPARQL on top\u001b[0m\r\n"]
[0.711028, "o", "\u001b[1;36m# Demo tx: May 2026 disbursement of 18,750 USDM from the Amaru treasury\u001b[0m\r\n"]
[3.417382, "o", "\u001b[H\u001b[J\u001b[3J"]
[3.417437, "o", "\u001b[1;32m# Pipeline 1 — bare: tx-graph | tx-view (the explorer baseline)\u001b[0m\r\n"]
[4.722555, "o", "\u001b[1;33m$ tx-graph /tmp/demo/c150.cbor 2>/dev/null | tx-view --graph - --view cli-tree | head -22\u001b[0m\r\n"]
