[73.885, "o", "\u001b[38;5;244m# typed-decode is live -- Sundae order datums are first-class triples\u001b[0m\r\n"]
[75.085, "o", "\u001b[1;32moperator@cq-rdf\u001b[0m:\u001b[1;34m~/case\u001b[0m$ "]
