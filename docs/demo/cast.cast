[8.345831, "o", "\u001b[1;36m# Raw addresses, opaque asset URNs — same as any block explorer.\u001b[0m\r\n"]
[11.052085, "o", "\u001b[H\u001b[J\u001b[3J"]
[11.052396, "o", "\u001b[1;32m# Pipeline 2 — same tx, with the operator overlay (--rules)\u001b[0m\r\n"]
