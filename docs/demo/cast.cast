[10.885, "o", "# Operator overlay for the May 2026 Amaru Treasury case study.\r\n"]
[10.9975, "o", "#\r\n"]
[11.11, "o", "# Phase 3 of epic #66 (separate runtime from apps): non-cardano\r\n"]
[11.2225, "o", "# vocabularies are opt-in through this `imports:` block. The treasury\r\n"]
[11.335, "o", "# vocab owns the `paid-via`, `role`, `attests`, and `ipfs` keys.\r\n"]
[11.4475, "o", "#\r\n"]
[11.56, "o", "# Typed-decode of on-chain datums/redeemers is delivered by the\r\n"]
[11.6725, "o", "# separate `cq-rdf blueprint --blueprints blueprints/` pass shipped\r\n"]
[11.785, "o", "# in this directory; it is not declared here.\r\n"]
[11.8975, "o", "imports:\r\n"]
[12.01, "o", "  - treasury\r\n"]
[12.1225, "o", "\r\n"]
[12.235, "o", "entities:\r\n"]
[12.3475, "o", "  - name: amaru-treasury.contingency\r\n"]
[12.46, "o", "    from-address: addr1x8ndhlcfy30t38z0tql64fpg8ply93r37xrgvdagfpsz5nhxm0lsjfz7hzwy7kpl42jzswr7gtz8ruvxscm6sjrq9f8qruq0ae\r\n"]
[12.5725, "o", "  - name: amaru-treasury.network_compliance\r\n"]
