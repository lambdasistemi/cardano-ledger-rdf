# Which transaction spent which? — the cross-tx join, and the swap chain.
#
# Each row is one realised spend edge: consumer transaction B spent output
# #ix of producer transaction A, where BOTH are in the lattice. The edge
# exists only because cat-merging the per-tx Turtle put A's output and B's
# input on the same content-addressed urn:cardano:utxo: IRI (#56/#57), so
# SPARQL joins them with no synthetic fixtures. The producer's recipient
# scope is resolved through the overlay entities.
#
# Sorted by ADA, the result lays the sequential swap chain bare: each swap
# spends the previous swap's change output (#2 at network_compliance) and
# the ADA steps down as it is converted to USDM —
#   64f27254 → dfd35553 → 10a5c1da → b5716ae9 → 26ef34aa → …
# This is exactly the auditor's "show me everything this wallet did, in
# order" — reconstructed from independent per-transaction graphs.
PREFIX cardano: <https://lambdasistemi.github.io/cardano-ledger-rdf/vocab/cardano#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?producer ?ix ?consumer ?scope (?lov / 1000000.0 AS ?ada)
WHERE {
  ?ptxn a cardano:Transaction ; cardano:hasTxId/cardano:bytesHex ?ptx ; cardano:hasOutput ?o .
  ?o cardano:hasIndex ?ix ; cardano:lovelace ?lov ; cardano:atAddress/cardano:bech32 ?addr .
  ?entity a cardano:Entity ; rdfs:label ?scope ; cardano:bech32 ?addr .
  ?ctxn a cardano:Transaction ; cardano:hasTxId/cardano:bytesHex ?ctx ;
        cardano:hasInput/cardano:fromTxOutRef ?ref .
  ?ref cardano:hasTxId/cardano:bytesHex ?ptx ; cardano:hasIndex ?ix .
  FILTER (?ptx != ?ctx)
  BIND (SUBSTR(?ptx, 1, 12) AS ?producer)
  BIND (SUBSTR(?ctx, 1, 12) AS ?consumer)
}
ORDER BY DESC(?ada)
LIMIT 12
