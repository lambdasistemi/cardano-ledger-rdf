# Where did the treasury's USDM end up? — net standing per scope.
#
# The honest "where did the money go" question. For every USDM-bearing
# output, we resolve the recipient to an operator scope BY JOINING TO THE
# OVERLAY ENTITIES (cardano:bech32) — so only addresses the operator has
# named (the treasury scopes and the vendor bridge) are counted at all.
# SundaeSwap pool, batcher and external addresses carry no entity, so they
# drop out automatically: no "other" bucket, no pool liquidity, no
# double-counted swap-chain change.
#
# An output is counted only if it is NOT spent again inside the lattice
# (EXISTS over the producer/consumer join). That nets out cycling change:
# the ~1.5M USDM that bounced through network_compliance as the swaps
# consolidated cancels to the standing balance. What survives is where the
# USDM actually came to rest:
#
#   amaru.cag-payee                    418750.0   (paid out to vendors)
#   amaru-treasury.network_compliance    6381.62  (remainder still held)
#
# Sum = 425,131.62 USDM ever acquired = 418,750 paid + 6,381.62 retained.
# USDM carries 6 decimals.
PREFIX cardano: <https://lambdasistemi.github.io/cardano-ledger-rdf/vocab/cardano#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?scope (SUM(?standing) AS ?usdm)
WHERE {
  ?entity a cardano:Entity ; rdfs:label ?scope ; cardano:bech32 ?addr .
  ?tx a cardano:Transaction ; cardano:hasTxId/cardano:bytesHex ?ptxid ; cardano:hasOutput ?out .
  ?out cardano:atAddress/cardano:bech32 ?addr ;
       cardano:hasIndex ?ix ;
       cardano:hasAssetValue/rdf:rest*/rdf:first ?asset .
  ?asset cardano:hasIdentifier/cardano:bytesHex
           "c48cbb3d5e57ed56e276bc45f99ab39abe94e6cd7ac39fb402da47ad0014df105553444d" ;
         cardano:quantity ?raw .
  BIND (?raw / 1000000.0 AS ?received)
  BIND (EXISTS {
          ?c cardano:hasInput/cardano:fromTxOutRef ?ref .
          ?ref cardano:hasTxId/cardano:bytesHex ?ptxid ; cardano:hasIndex ?ix .
        } AS ?spentAgain)
  BIND (IF(?spentAgain, 0.0, ?received) AS ?standing)
}
GROUP BY ?scope
HAVING (SUM(?standing) > 0)
ORDER BY DESC(?usdm)
