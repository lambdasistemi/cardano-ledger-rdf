#!/usr/bin/env bash
# tx-lattice — thin convenience wrapper around tx-graph --provider.
#
# Architecture (post-#114, simplified in #59):
#
#   tx-graph  emits an optional rules overlay and one canonical Turtle graph
#             per transaction. With --provider it fetches each transaction's
#             CBOR by txid from an HTTP indexer (koios | blockfrost | http).
#             This wrapper composes the lattice by writing the overlay once
#             and concatenating one body graph per txid into
#             <out-dir>/lattice.ttl.
#
#   For one-tx-at-a-time emit, use tx-graph directly.
#
# Usage:
#   tx-lattice [--rules rules.yaml] --out-dir DIR \
#              [--provider koios|blockfrost|http] [--token TOKEN] [--url URL] \
#              <txId1> <txId2> ... <txIdN>
#
# Env:
#   TX_GRAPH_EXE  override path to tx-graph binary
#                 (default: tx-graph on PATH, else result/bin/tx-graph)

set -euo pipefail

PROVIDER="koios"
TOKEN=""
URL=""
RULES=""
OUT_DIR=""
TXIDS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rules)    RULES="$2"; shift 2 ;;
    --out-dir)  OUT_DIR="$2"; shift 2 ;;
    --provider) PROVIDER="$2"; shift 2 ;;
    --token)    TOKEN="$2"; shift 2 ;;
    --url)      URL="$2"; shift 2 ;;
    --help|-h)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    -*) echo "tx-lattice: unknown flag $1" >&2; exit 2 ;;
    *)  TXIDS+=("$1"); shift ;;
  esac
done

[[ -n "$OUT_DIR" ]] || { echo "tx-lattice: --out-dir required" >&2; exit 2; }
[[ ${#TXIDS[@]} -gt 0 ]] || { echo "tx-lattice: pass at least one txId" >&2; exit 2; }

if [[ -n "${TX_GRAPH_EXE:-}" ]]; then
  TXG="$TX_GRAPH_EXE"
elif command -v tx-graph >/dev/null 2>&1; then
  TXG="$(command -v tx-graph)"
elif [[ -x "result/bin/tx-graph" ]]; then
  TXG="result/bin/tx-graph"
else
  echo "tx-lattice: tx-graph not found — set TX_GRAPH_EXE, put tx-graph on PATH, or run 'nix build .#tx-graph' first" >&2
  exit 2
fi

PROVIDER_ARGS=(--provider "$PROVIDER")
[[ -n "$TOKEN" ]] && PROVIDER_ARGS+=(--token "$TOKEN")
[[ -n "$URL" ]] && PROVIDER_ARGS+=(--url "$URL")

mkdir -p "$OUT_DIR"
OUT_TTL="$OUT_DIR/lattice.ttl"
if [[ -n "$RULES" ]]; then
  "$TXG" --rules "$RULES" > "$OUT_TTL"
else
  : > "$OUT_TTL"
fi

for txid in "${TXIDS[@]}"; do
  "$TXG" "${PROVIDER_ARGS[@]}" "$txid"
done >> "$OUT_TTL"

echo "tx-lattice: done. ${#TXIDS[@]} tx graph(s) via --provider $PROVIDER → $OUT_TTL" >&2
