#!/usr/bin/env bash
# tx-lattice — thin convenience wrapper around cq-rdf overlay/body.
#
# Architecture (post-#114, simplified in #59):
#
#   cq-rdf overlay emits the rules overlay once.
#   cq-rdf body emits one canonical Turtle graph per transaction. With
#   --provider it fetches each transaction's CBOR by txid from an HTTP
#   indexer (koios | blockfrost | http).
#
#   For one-tx-at-a-time emit, use cq-rdf body directly.
#
# Usage:
#   tx-lattice [--rules rules.yaml] --out-dir DIR \
#              [--provider koios|blockfrost|http] [--token TOKEN] [--url URL] \
#              <txId1> <txId2> ... <txIdN>
#
# Env:
#   CQ_RDF_EXE  override path to cq-rdf binary
#               (default: cq-rdf on PATH, else result/bin/cq-rdf)

set -euo pipefail

PROVIDER="koios"
TOKEN=""
URL=""
RULES=""
OUT_DIR=""
TXIDS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rules)    RULES="$2"; shift 2 ;;
    --out-dir)  OUT_DIR="$2"; shift 2 ;;
    --provider) PROVIDER="$2"; shift 2 ;;
    --token)    TOKEN="$2"; shift 2 ;;
    --url)      URL="$2"; shift 2 ;;
    --help|-h)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    -*) echo "tx-lattice: unknown flag $1" >&2; exit 2 ;;
    *)  TXIDS+=("$1"); shift ;;
  esac
done

[[ -n "$OUT_DIR" ]] || { echo "tx-lattice: --out-dir required" >&2; exit 2; }
[[ ${#TXIDS[@]} -gt 0 ]] || { echo "tx-lattice: pass at least one txId" >&2; exit 2; }

if [[ -n "${CQ_RDF_EXE:-}" ]]; then
  CQRDF="$CQ_RDF_EXE"
elif command -v cq-rdf >/dev/null 2>&1; then
  CQRDF="$(command -v cq-rdf)"
elif [[ -x "result/bin/cq-rdf" ]]; then
  CQRDF="result/bin/cq-rdf"
else
  echo "tx-lattice: cq-rdf not found — set CQ_RDF_EXE, put cq-rdf on PATH, or run 'nix build .#cq-rdf' first" >&2
  exit 2
fi

PROVIDER_ARGS=(--provider "$PROVIDER")
[[ -n "$TOKEN" ]] && PROVIDER_ARGS+=(--token "$TOKEN")
[[ -n "$URL" ]] && PROVIDER_ARGS+=(--url "$URL")

mkdir -p "$OUT_DIR"
OUT_TTL="$OUT_DIR/lattice.ttl"
if [[ -n "$RULES" ]]; then
  "$CQRDF" overlay --in "$RULES" > "$OUT_TTL"
else
  : > "$OUT_TTL"
fi

for txid in "${TXIDS[@]}"; do
  "$CQRDF" body "${PROVIDER_ARGS[@]}" "$txid"
done >> "$OUT_TTL"

echo "tx-lattice: done. ${#TXIDS[@]} tx graph(s) via --provider $PROVIDER → $OUT_TTL" >&2
